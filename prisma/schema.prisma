generator client {
    provider = "prisma-client-js"
    output   = "../src/lib/db"
}

datasource db {
    provider = "postgresql"
}

model Card {
    id          Int      @id @default(autoincrement())
    template    Template @relation(fields: [templateId], references: [id])
    templateId  Int
    title       String
    description String
    qrCode      String?
    sender      String?
    receiver    String?
    slug        String   @unique
    createdAt   DateTime @default(now())
    audioUrl    String?
    cardUuid    String @unique @default(uuid())
}

model Template {
    id          Int      @id @default(autoincrement())
    cards       Card[]
    title       String
    titlePos    TitlePosition   @default(top)
    description String?
    type        String
    background  String
    backgroundBack String @default("")
    font        String   @default("Arial")
    createdAt   DateTime @default(now())
}

enum TitlePosition {
    top
    bottom
    center
}
