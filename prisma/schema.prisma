// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/db"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id          Int       @id @default(autoincrement())
  // Null for cards whose front is an AI-generated image (see backgroundUrl)
  template    Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateId  Int?
  qrCode      String?
  sender      String?
  receiver    String?
  slug        String    @unique
  createdAt   DateTime  @default(now())
  audioUrl    String?
  cardUuid    String    @unique @default(uuid())
  description String?
  title       String?
  physical    Boolean   @default(false)

  // AI generation: blob URL of the generated front image, the prompt sent to
  // the image model, and the category the image was constrained to.
  backgroundUrl String?
  prompt        String?
  category      Category? @relation(fields: [categoryId], references: [id])
  categoryId    Int?

  // Per-card typography. Null means "use the template's value".
  titlePos            TitlePosition?
  titleFont           String?
  titleFontSize       Int?
  titleColor          String?
  descriptionFont     String?
  descriptionFontSize Int?
  descriptionColor    String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([userId])
  @@map("cards")
}

model Template {
  id             Int           @id @default(autoincrement())
  cards          Card[]
  title          String?
  titlePos       TitlePosition @default(top)
  titleFontSize  Int           @default(24) // Font size in pixels for the card title
  description    String?
  background     String
  backgroundBack String        @default("#ffffff")
  font           Font          @relation(fields: [fontId], references: [id])
  fontId         Int           @default(1)
  fontColor      String        @default("#ffffff")
  categories     Category      @relation(fields: [categoryId], references: [id])
  categoryId     Int
  createdAt      DateTime      @default(now())

  @@index([categoryId])
  @@map("templates")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  templates Template[]
  cards     Card[]

  @@map("categories")
}

model Font {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  templates Template[]

  @@map("fonts")
}

enum TitlePosition {
  top
  right
  bottom
  left
  center
}

// better-auth core tables. Prefixed with auth_ so they never collide with the
// external dashboard's `users` / `sessions` tables (see prisma.config.ts).
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  cards         Card[]

  @@map("auth_user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}
