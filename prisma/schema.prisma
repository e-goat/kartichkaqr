generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/db"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id          Int      @id @default(autoincrement())
  template    Template @relation(fields: [templateId], references: [id])
  templateId  Int
  qrCode      String?
  sender      String?
  receiver    String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  audioUrl    String?
  cardUuid    String   @unique @default(uuid())
  description String?
  title       String?
  physical    Boolean  @default(false)

  @@map("cards")
}

model Template {
  id             Int           @id @default(autoincrement())
  cards          Card[]
  title          String?
  titlePos       TitlePosition @default(top)
  titleFontSize  Int           @default(24) // Font size in pixels for the card title
  description    String?
  background     String
  backgroundBack String        @default("#ffffff")
  font           Font          @relation(fields: [fontId], references: [id])
  fontId         Int           @default(1)
  fontColor      String        @default("#ffffff")
  categories     Category      @relation(fields: [categoryId], references: [id])
  categoryId     Int
  createdAt      DateTime      @default(now())

  @@index([categoryId])
  @@map("templates")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  templates Template[]

  @@map("categories")
}

model Font {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  templates Template[]

  @@map("fonts")
}

enum TitlePosition {
  top
  right
  bottom
  left
  center
}
