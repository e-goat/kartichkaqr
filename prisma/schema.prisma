generator client {
    provider = "prisma-client-js"
    output   = "../src/lib/db"
}

datasource db {
    provider = "postgresql"
}

model Card {
    id          Int      @id @default(autoincrement())
    template    Template @relation(fields: [templateId], references: [id])
    templateId  Int
    title       String
    description String
    qrCode      String?
    sender      String?
    receiver    String?
    slug        String   @unique
    createdAt   DateTime @default(now())
    audioUrl    String?
    cardUuid    String   @unique @default(uuid())

    @@map("cards")
}

model Template {
    id             Int           @id @default(autoincrement())
    cards          Card[]
    title          String
    titlePos       TitlePosition @default(top)
    description    String?
    type           String
    background     String
    backgroundBack String        @default("")
    font           Font         @relation(fields: [fontId], references: [id])
    fontId         Int          @default(1)
    createdAt      DateTime      @default(now())
    categories     Category      @relation(fields: [categoryId], references: [id])
    categoryId     Int

    @@map("templates")
}

model Category {
    id        Int        @id @default(autoincrement())
    name      String     @unique
    templates Template[]

    @@map("categories")
}

model Font {
    id        Int        @id @default(autoincrement())
    name      String     @unique
    templates Template[]

    @@map("fonts")
}

enum TitlePosition {
    top
    bottom
    center
}
