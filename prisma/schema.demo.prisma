generator client {
    provider = "prisma-client-js"
    output   = "../src/lib/db"
}

datasource db {
    provider = "postgresql"
}

model Card {
    id          Int          @id @default(autoincrement())
    templateId  Int
    title       String
    description String
    sender      String?
    receiver    String?
    slug        String       @unique
    createdAt   DateTime     @default(now())
    qrCode      String?
    audioUrl    String?
    cardUuid    String       @unique
    category    CardCategory @default(Other)
    Template    Template     @relation(fields: [templateId], references: [id])

    @@map("cards")
}

model Template {
    id             Int           @id @default(autoincrement())
    title          String
    description    String        @default("")
    type           String
    background     String
    font           String        @default("Arial")
    createdAt      DateTime      @default(now())
    backgroundBack String        @default("")
    titlePos       TitlePosition @default(top)
    Card           Card[]

    @@map("templates")
}

model dashboard_migrations {
    id        Int    @id(map: "migrations_pkey") @default(autoincrement())
    migration String @db.VarChar(255)
    batch     Int

    @@map("_dashboard_migrations")
}

model cache {
    key        String @id @db.VarChar(255)
    value      String
    expiration Int
}

model cache_locks {
    key        String @id @db.VarChar(255)
    owner      String @db.VarChar(255)
    expiration Int
}

model failed_jobs {
    id         BigInt   @id @default(autoincrement())
    uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
    connection String
    queue      String
    payload    String
    exception  String
    failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
    id             String  @id @db.VarChar(255)
    name           String  @db.VarChar(255)
    total_jobs     Int
    pending_jobs   Int
    failed_jobs    Int
    failed_job_ids String
    options        String?
    cancelled_at   Int?
    created_at     Int
    finished_at    Int?
}

model jobs {
    id           BigInt @id @default(autoincrement())
    queue        String @db.VarChar(255)
    payload      String
    attempts     Int    @db.SmallInt
    reserved_at  Int?
    available_at Int
    created_at   Int

    @@index([queue], map: "jobs_queue_index")
}

model password_reset_tokens {
    email      String    @id @db.VarChar(255)
    token      String    @db.VarChar(255)
    created_at DateTime? @db.Timestamp(0)
}

model sessions {
    id            String  @id @db.VarChar(255)
    user_id       BigInt?
    ip_address    String? @db.VarChar(45)
    user_agent    String?
    payload       String
    last_activity Int

    @@index([last_activity], map: "sessions_last_activity_index")
    @@index([user_id], map: "sessions_user_id_index")
}

model users {
    id                BigInt    @id @default(autoincrement())
    name              String    @db.VarChar(255)
    email             String    @unique(map: "users_email_unique") @db.VarChar(255)
    email_verified_at DateTime? @db.Timestamp(0)
    password          String    @db.VarChar(255)
    remember_token    String?   @db.VarChar(100)
    created_at        DateTime? @db.Timestamp(0)
    updated_at        DateTime? @db.Timestamp(0)
}

enum CardCategory {
    Gratitude   @map("Благодарност")
    Love        @map("Любов")
    Support     @map("Подкрепа")
    Celebration @map("Празненство")
    SpecialDays @map("Специални дни")
    Other       @map("Други")
}

enum TitlePosition {
    top
    bottom
    center
}
